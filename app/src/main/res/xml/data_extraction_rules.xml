<?xml version="1.0" encoding="utf-8"?>
<!--
   Sicherung durch Android (ab Android 12). Das KI-Modell (mehrere GB) wird nicht gesichert,
   es lässt sich jederzeit neu laden.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="models/" />
    </device-transfer>
</data-extraction-rules>
